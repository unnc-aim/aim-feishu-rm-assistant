# Feishu open platform app credentials, see README for how to create the app.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Base URL of the rm-search production deployment.
RMSEARCH_BASE_URL=https://search.scutbot.cn

# OpenAI-compatible chat completion API.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# SQLite database file path.
SQLITE_PATH=./data/assistant.db

# Log directory; logs rotate daily into assistant-YYYY-MM-DD.log files
# inside it. Every incoming user message and action is logged here in
# addition to stderr.
LOG_DIR=./data/logs

# Default digest push time (local time) for new subscriptions.
PUSH_DEFAULT_HOUR=20
PUSH_DEFAULT_MINUTE=0

# Timezone override for schedule evaluation, e.g. Asia/Shanghai.
# Leave empty to follow the host zone via the mounted /etc files.
TZ=
